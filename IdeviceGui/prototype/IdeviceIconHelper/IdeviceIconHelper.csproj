<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>IdeviceIconHelper</AssemblyName>
    <ToolkitDir Condition="'$(ToolkitDir)' == '' and '$(RepoToolkitDir)' != '' and Exists('$(RepoToolkitDir)\ideviceinstaller.exe')">$(RepoToolkitDir)</ToolkitDir>
    <ToolkitDir Condition="'$(ToolkitDir)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\..\idevice-toolkit\ideviceinstaller.exe')">$(MSBuildThisFileDirectory)..\..\..\idevice-toolkit</ToolkitDir>
    <ToolkitDir Condition="'$(ToolkitDir)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\..\toolkit\ideviceinstaller.exe')">$(MSBuildThisFileDirectory)..\..\..\toolkit</ToolkitDir>
    <RootNamespace>IdeviceIconHelper</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(ToolkitDir)\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
