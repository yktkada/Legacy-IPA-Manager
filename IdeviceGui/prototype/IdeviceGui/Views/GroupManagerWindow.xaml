<Window x:Class="IdeviceGui.Views.GroupManagerWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:IdeviceGui.Resources"
        Title="{x:Static res:Strings.Group_Manager_Title}" Width="360" Height="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{x:Static res:Strings.Group_Manager_Rename}" Width="82" Padding="0,3" Click="OnRenameClick" />
            <Button Content="{x:Static res:Strings.Group_Manager_Delete}" Width="82" Padding="0,3" Margin="8,0,0,0" Click="OnDeleteClick" />
            <Button Content="{x:Static res:Strings.Group_Manager_Close}" Width="82" Padding="0,3" Margin="8,0,0,0"
                    IsCancel="True" Click="OnCloseClick" />
        </StackPanel>
        <ListBox x:Name="GroupsList" ItemsSource="{Binding Groups}"
                 BorderBrush="#FFC8C8C8" BorderThickness="1" />
    </DockPanel>
</Window>
