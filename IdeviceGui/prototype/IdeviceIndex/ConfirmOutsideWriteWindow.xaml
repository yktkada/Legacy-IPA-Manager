<Window x:Class="IdeviceIndex.ConfirmOutsideWriteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:IdeviceIndex.Resources"
        Title="{x:Static res:Strings.Settings_Security_ConfirmTitle}"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="{x:Static res:Strings.Settings_Security_ConfirmTitle}"
                   FontSize="15" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBlock Text="{x:Static res:Strings.Settings_Security_ConfirmBody}"
                   TextWrapping="Wrap" Margin="0,0,0,10" />
        <Border Background="#FFFFF4E5" BorderBrush="#FFE5B870" BorderThickness="1" Padding="10" Margin="0,0,0,14">
            <TextBlock Text="{x:Static res:Strings.Settings_Security_ConfirmRisk}"
                       Foreground="#FF663C00" TextWrapping="Wrap" />
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="{x:Static res:Strings.Settings_Security_ConfirmCancel}"
                    Width="88" Padding="0,4" IsCancel="True" Click="OnCancelClick" />
            <Button x:Name="EnableButton" Content="{x:Static res:Strings.Settings_Security_ConfirmEnable}"
                    Width="88" Padding="0,4" Margin="8,0,0,0" Click="OnEnableClick" />
        </StackPanel>
    </StackPanel>
</Window>
