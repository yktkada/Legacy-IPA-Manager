<Window x:Class="IdeviceGui.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:IdeviceGui.Views"
        xmlns:res="clr-namespace:IdeviceGui.Resources"
        Title="Legacy IPA Manager" Height="760" Width="1180" MinHeight="720"
        Icon="pack://application:,,,/IdeviceGui;component/app.ico"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- 2026-11-01 用户定：选中改灰（蓝只留给双击 armed），单元格去掉焦点黑框 -->
        <SolidColorBrush x:Key="SelectedRowBrush" Color="#FFE6E6E6" />
        <!-- 2026-11-02 用户定：绿色 = 队列安装成功后的临时提示（行底色 / 组行图标列底色） -->
        <SolidColorBrush x:Key="InstalledRowBrush" Color="#FFD9F2D9" />
        <SolidColorBrush x:Key="ArmedRowBrush" Color="#FF2F6FD0" />
        <SolidColorBrush x:Key="FailedRowBrush" Color="#FFFFD9D9" />
        <SolidColorBrush x:Key="InstallWaitingRowBrush" Color="#FFB4D2F0" />
        <SolidColorBrush x:Key="InstallActiveRowBrush" Color="#FF7FA9DC" />
        <SolidColorBrush x:Key="UninstallWaitingRowBrush" Color="#FFFFDD85" />
        <SolidColorBrush x:Key="UninstallActiveRowBrush" Color="#FFEDB93F" />
        <SolidColorBrush x:Key="PausedRowBrush" Color="#FFD0D0D0" />

        <Style x:Key="LibraryRowStyle" TargetType="DataGridRow">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <!-- 文件已删除：明确置灰（整行降不透明度+灰底灰字）；优先级最低 -->
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter Property="Background" Value="#FFECECEC" />
                    <Setter Property="Foreground" Value="#FF888888" />
                    <Setter Property="Opacity" Value="0.62" />
                </DataTrigger>
                <!-- 选中：整行灰；文字前景由 LibraryCellStyle 按普通黑/缺失灰决定 -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedRowBrush}" />
                </Trigger>
                <!-- 文件行：统一操作色；组行不铺行色，组行状态只画在 icon 列 -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsGroup}" Value="False" />
                        <Condition Binding="{Binding Visual}" Value="Failed" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource FailedRowBrush}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsGroup}" Value="False" />
                        <Condition Binding="{Binding Visual}" Value="UninstallActive" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource UninstallActiveRowBrush}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsGroup}" Value="False" />
                        <Condition Binding="{Binding Visual}" Value="InstallActive" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource InstallActiveRowBrush}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsGroup}" Value="False" />
                        <Condition Binding="{Binding Visual}" Value="Paused" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource PausedRowBrush}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsGroup}" Value="False" />
                        <Condition Binding="{Binding Visual}" Value="UninstallWaiting" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource UninstallWaitingRowBrush}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsGroup}" Value="False" />
                        <Condition Binding="{Binding Visual}" Value="InstallWaiting" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource InstallWaitingRowBrush}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsGroup}" Value="False" />
                        <Condition Binding="{Binding Visual}" Value="Succeeded" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource InstalledRowBrush}" />
                </MultiDataTrigger>
                <!-- 组行上下边线 -->
                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                    <Setter Property="BorderBrush" Value="#FFC8C8C8" />
                    <Setter Property="BorderThickness" Value="0,1,0,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsGroupEnd}" Value="True">
                    <Setter Property="BorderBrush" Value="#FFC8C8C8" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsGroup}" Value="True" />
                        <Condition Binding="{Binding IsGroupEnd}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderThickness" Value="0,1,0,1" />
                </MultiDataTrigger>
                <!-- 单击待确认最高优先级 -->
                <DataTrigger Binding="{Binding IsArmed}" Value="True">
                    <Setter Property="Background" Value="{StaticResource ArmedRowBrush}" />
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                    <Setter Property="Opacity" Value="1.0" />
                </DataTrigger>
                <!-- 多选选中：复用 armed 蓝色；只由多选模式设置 -->
                <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource ArmedRowBrush}" />
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                    <Setter Property="Opacity" Value="1.0" />
                </DataTrigger>
                <!-- 多选追加的「隐藏但已选」行上方分隔线；必须最后，避免被组行/三色覆盖 -->
                <DataTrigger Binding="{Binding IsAppendedSeparator}" Value="True">
                    <Setter Property="Height" Value="1" />
                    <Setter Property="MinHeight" Value="1" />
                    <Setter Property="MaxHeight" Value="1" />
                    <Setter Property="Background" Value="#FFE0E0E0" />
                    <Setter Property="BorderBrush" Value="#FFC8C8C8" />
                    <Setter Property="BorderThickness" Value="0,1,0,0" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                    <Setter Property="Focusable" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 设备应用行样式：直接复制 LibraryRowStyle 的颜色/armed 逻辑（2026-11-06 用户要求复制粘贴 + 注释）。
             不绑定 IsGroup / IsGroupEnd，设备应用没有组行。 -->
        <Style x:Key="DeviceAppRowStyle" TargetType="DataGridRow">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedRowBrush}" />
                    <Setter Property="Foreground" Value="#FF000000" />
                </Trigger>
                <DataTrigger Binding="{Binding Visual}" Value="Failed">
                    <Setter Property="Background" Value="{StaticResource FailedRowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Visual}" Value="UninstallActive">
                    <Setter Property="Background" Value="{StaticResource UninstallActiveRowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Visual}" Value="InstallActive">
                    <Setter Property="Background" Value="{StaticResource InstallActiveRowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Visual}" Value="Paused">
                    <Setter Property="Background" Value="{StaticResource PausedRowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Visual}" Value="UninstallWaiting">
                    <Setter Property="Background" Value="{StaticResource UninstallWaitingRowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Visual}" Value="InstallWaiting">
                    <Setter Property="Background" Value="{StaticResource InstallWaitingRowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Visual}" Value="Succeeded">
                    <Setter Property="Background" Value="{StaticResource InstalledRowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsArmed}" Value="True">
                    <Setter Property="Background" Value="{StaticResource ArmedRowBrush}" />
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource ArmedRowBrush}" />
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 设备应用单元格：必须把单元格背景设为透明，否则 DataGrid 默认选中蓝会盖住整行颜色。
             2026-11-06 实测：之前只设 RowStyle，单击看到的是系统选中蓝，不是 armed 深蓝。 -->
        <Style x:Key="DeviceAppCellStyle" TargetType="DataGridCell">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="TextElement.Foreground" Value="#FF000000" />
            <Setter Property="BorderBrush" Value="#FFC8C8C8" />
            <Setter Property="BorderThickness" Value="0,0,0.5,0" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                    <Setter Property="TextElement.Foreground" Value="#FFFFFFFF" />
                </Trigger>
                <DataTrigger Binding="{Binding IsArmed}" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                    <Setter Property="TextElement.Foreground" Value="#FFFFFFFF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                    <Setter Property="TextElement.Foreground" Value="#FFFFFFFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 设备应用文字：DataGridTextColumn 的 TextBlock 不继承 DataGridCell.Foreground，
             这里显式给 ElementStyle，多选/armed 时把字刷白。 -->
        <Style x:Key="DeviceAppTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF000000" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsArmed}" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LibraryCellStyle" TargetType="DataGridCell">
            <!-- 只去焦点黑框；背景透明让整行颜色透上来；
                 前景**在单元格上显式设黑**（左键选中/键盘焦点时 WPF 默认会把字刷白，实测右键黑、左键白），
                 armed（深蓝）时由 DataTrigger 改成白字；
                 竖向分割线：右侧 0.5 DIP 细线（与横向行线同色 #C8C8C8） -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="BorderBrush" Value="#FFC8C8C8" />
            <Setter Property="BorderThickness" Value="0,0,0.5,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter Property="Foreground" Value="#FF888888" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsArmed}" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                </DataTrigger>
            </Style.Triggers></Style>
        <!-- 勾列 / 图标列不画竖向分割线（2026-11-02 用户定） -->
        <Style x:Key="LibraryCellStyleNoSeparator" TargetType="DataGridCell" BasedOn="{StaticResource LibraryCellStyle}">
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <!-- ✓ 列（2026-11-02 用户定）：**打勾的行 → 勾列整格绿底**（与安装成功同色），勾本身仍是黑色。
             优先于选中灰；armed（深蓝）时让位，避免蓝行里亮一块绿。 -->
        <Style x:Key="LibraryInstalledCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource LibraryCellStyleNoSeparator}">
            <!-- 勾列独立：默认白底；同版本绿底；armed/操作色都不得覆盖。 -->
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter Property="Background" Value="#FFECECEC" />
                    <Setter Property="Foreground" Value="#FF888888" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInstalledTicked}" Value="True">
                    <Setter Property="Background" Value="{StaticResource InstalledRowBrush}" />
                    <Setter Property="Foreground" Value="#FF000000" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsGroupInstalledTicked}" Value="True">
                    <Setter Property="Background" Value="{StaticResource InstalledRowBrush}" />
                    <Setter Property="Foreground" Value="#FF000000" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsArmed}" Value="True">
                    <Setter Property="Foreground" Value="#FF000000" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 图标列（2026-11-02 用户定）：**默认白底**；只有组行按成员聚合状态整格染色
             （黄=在队列 / 红=失败 / 绿=安装成功，放在「N 个」那一格），个数照常显示、文字 #4A4A4A。 -->
        <Style x:Key="LibraryIconCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource LibraryCellStyleNoSeparator}">
            <!-- 文件行白底；组行背景由 GroupIconBrush 给出（只按匹配已安装版本成员聚合）。 -->
            <Setter Property="Background" Value="{Binding GroupIconBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter Property="Background" Value="#FFECECEC" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 图标列模板（2026-11-01）：文件行显示图标（尺寸=行高、居中、正方形）；组行显示个数。
             底色由 LibraryIconCellStyle 负责（2026-11-02：默认白，组行按状态整格染色）。 -->
        <DataTemplate x:Key="IconCellTemplate">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="{Binding Icon}" Stretch="Uniform"
                       Width="{Binding DataContext.LibraryRowHeight, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                       Height="{Binding DataContext.LibraryRowHeight, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <!-- 组行：组内个数（2026-11-01：从名称列拆出来放图标列）；
                     2026-11-02 用户定：组行图标列整格染色时「N 个」文字**略微加深**（#4A4A4A，不用纯黑） -->
                <TextBlock Text="{Binding GroupText}" FontSize="11" Foreground="#FF4A4A4A"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <!-- ✓ 列模板（2026-11-02 用户定）：文件行只显示勾；**组行 = 勾在上、展开三角在下（两行同时显示）**。
             勾 11 DIP、三角 9 DIP（三角改更大的字形 ▶/▼ 抵消字号变小）；`◐` 已废弃。
             勾 = 设备上装着「同 BundleId + 同版本」；组行 = 任一成员已装（LibraryInstalledStates）。 -->
        <DataTemplate x:Key="InstalledCellTemplate">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- 勾（文件行：已装；组行：任一成员已装） -->
                <TextBlock Text="✓" FontSize="11" FontFamily="Segoe UI Symbol"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding InstalledState}" Value="Yes">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <!-- 2026-11-06：其他版本也显示 ✓；绿色只由同版本勾列底色表达。 -->
                                <DataTrigger Binding="{Binding InstalledState}" Value="OtherVersion">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- 展开三角（只有组行）：折叠 ▶ / 展开 ▼（不旋转、大小不变） -->
                <TextBlock FontSize="9" Foreground="#FF808080" FontFamily="Segoe UI Symbol"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Text" Value="▶" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCollapsed}" Value="False">
                                    <Setter Property="Text" Value="▼" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="QueueItemStyle" TargetType="ListBoxItem">
            <!-- 2026-11-01 用户定：队列行高 24 DIP、垂直居中、选中灰底黑字 -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Background" Value="{Binding RowBrush}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedRowBrush}" />
                    <Setter Property="Foreground" Value="#FF000000" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="AddRootButton" Content="{x:Static res:Strings.Main_Toolbar_AddRoot}" Padding="12,4" Click="OnAddRootClick"
                    ToolTip="{x:Static res:Strings.Main_Toolbar_AddRootToolTip}" />
            <Button x:Name="OpenIndexButton" Content="{x:Static res:Strings.Main_Toolbar_OpenIndex}" Click="OnOpenIndexClick"
                    Padding="12,4" Margin="8,0,0,0"
                    ToolTip="{x:Static res:Strings.Main_Toolbar_OpenIndexToolTip}" />
            <Button x:Name="InstallToButton" Content="{x:Static res:Strings.Main_Toolbar_InstallTo}" Click="OnInstallToMenuClick"
                    IsEnabled="{Binding HasSelectedDevice}"
                    Padding="12,4" Margin="8,0,0,0" FontWeight="Bold" />
            <Button x:Name="LogToggleButton" Content="{x:Static res:Strings.Main_Toolbar_HideLog}" Click="OnToggleLogClick"
                    Padding="12,4" Margin="8,0,0,0"
                    ToolTip="{x:Static res:Strings.Main_Toolbar_LogToggleToolTip}" />
            <!-- 设置入口（2026-11-02 用户定：工具条最右，独立窗口） -->
            <Button x:Name="SettingsButton" Content="{x:Static res:Strings.Main_Toolbar_Settings}" Click="OnOpenSettingsClick"
                    Padding="12,4" Margin="8,0,0,0"
                    ToolTip="{x:Static res:Strings.Main_Toolbar_SettingsToolTip}" />

            <!-- 「更多 ▾」紧跟按钮（留更大间距、不贴最右）；无在线/选中设备时隐藏 -->
            <Button x:Name="MoreDeviceButton" Content="▾" Padding="8,2" Margin="24,0,0,0"
                    VerticalAlignment="Center" FontSize="12"
                    Visibility="{Binding HasSelectedDevice, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.AutomationId="MoreDeviceButton"
                    Click="OnMoreDeviceInfoClick"
                    ToolTip="{x:Static res:Strings.Main_Device_MoreInfoToolTip}">
                <Button.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                 Placement="Bottom">
                        <!-- 菜单 = 单列「值 + 点击复制」：信息行只读，其余点一下写剪贴板（2026-11-01 用户定；复制不提示） -->
                        <MenuItem Header="{Binding SelectedDevice.Device.UsageMenuText}" IsEnabled="False" />
                        <MenuItem Header="{Binding SelectedDevice.Device.HealthMenuText}" IsEnabled="False" />
                        <MenuItem Header="{Binding SelectedDevice.Device.ManufacturerMenuText}" IsEnabled="False" />
                        <MenuItem Header="{Binding SelectedDevice.Device.BatterySerialMenuText}" IsEnabled="False" />
                        <Separator />
                        <MenuItem Header="{Binding SelectedDevice.Device.EcidHexMenuText}" Click="OnCopyDeviceEcidHex" />
                        <MenuItem Header="{Binding SelectedDevice.Device.EcidDecimalMenuText}" Click="OnCopyDeviceEcidDecimal" />
                        <MenuItem Header="{Binding SelectedDevice.Device.SerialMenuText}" Click="OnCopyDeviceSerial" />
                        <MenuItem Header="{Binding SelectedDevice.Device.UdidMenuText}" Click="OnCopyDeviceUdid" />
                        <MenuItem Header="{Binding SelectedDevice.Device.ModelNumberMenuText}" Click="OnCopyDeviceModelNumber" />
                        <MenuItem Header="{Binding SelectedDevice.Device.HardwareModelMenuText}" Click="OnCopyDeviceHardwareModel" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <!-- 颜色色块（只有 hex 时显示） + 设备信息文本 -->
            <Border Width="12" Height="12" CornerRadius="2" Margin="10,0,0,0" VerticalAlignment="Center"
                    Background="{Binding SelectedDevice.Device.ColorBrush, TargetNullValue=Transparent}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedDevice.Device.HasColorSwatch}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding SelectedDevice.Device.InfoToolTip}"
                       Text="{Binding SelectedDevice.Device.InfoLine}" />
        </StackPanel>

        <!-- 设备行（M4-b4）：最左「刷新」+ TabControl 切换条（每台在线设备一个 TabItem） -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="{x:Static res:Strings.Main_Device_Refresh}" Command="{Binding RefreshDevicesCommand}" Padding="12,4"
                    VerticalAlignment="Top" ToolTip="{x:Static res:Strings.Main_Device_RefreshToolTip}" />
            <TabControl Grid.Column="1" x:Name="DeviceTabs" Margin="8,0,0,0"
                        ItemsSource="{Binding Devices}"
                        SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                        AutomationProperties.AutomationId="DeviceTabs"
                        PreviewMouseLeftButtonDown="OnDeviceTabClicked"
                        VerticalAlignment="Top">
                <TabControl.Style>
                    <Style TargetType="TabControl">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Style>
                <!-- 只用作切换条：模板里不渲染内容区，队列仍在中栏显示当前焦点设备 -->
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Border Background="Transparent" BorderBrush="#FFDDDDDD" BorderThickness="1"
                                CornerRadius="3" Padding="4,2">
                            <TabPanel IsItemsHost="True" />
                        </Border>
                    </ControlTemplate>
                </TabControl.Template>
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Padding" Value="4,2" />
                        <Setter Property="Margin" Value="0" />
                        <Style.Triggers>
                            <!-- 离线设备（2026-11-02 用户定）：置灰，并自动排到最后（排序在 ViewModel 里做） -->
                            <DataTrigger Binding="{Binding Device.Online}" Value="False">
                                <Setter Property="Foreground" Value="#FF9A9A9A" />
                                <Setter Property="Opacity" Value="0.55" />
                                <Setter Property="ToolTip" Value="{x:Static res:Strings.Main_Device_OfflineToolTip}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.ItemContainerStyle>
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 设备页签（2026-11-06 定稿）：
                             最左固定当前状态块（不叠文字）；后面是每任务一块的进度条；文字直接叠在进度条上。
                             不再使用半透明百分比遮罩。 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="20" Height="20" Margin="0,0,4,0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    CornerRadius="2"
                                    Background="{Binding CurrentStatusBrush}"
                                    Visibility="{Binding CurrentStatusVisible, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="{x:Static res:Strings.Main_Device_CurrentJobStatusToolTip}" />
                            <Grid Grid.Column="1">
                                <ItemsControl ItemsSource="{Binding TabBlocks}" Panel.ZIndex="0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Rectangle Fill="{Binding Brush}" Stroke="#FFFFFFFF" StrokeThickness="0.5" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Header}" VerticalAlignment="Center" Margin="4,0,4,0"
                                           Panel.ZIndex="1" Foreground="#FF111111"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Display}" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>
            <TextBlock Grid.Column="1" Text="{x:Static res:Strings.Main_Device_NoOnlineDevices}" Margin="8,0,0,0" VerticalAlignment="Center"
                       Foreground="#FF888888">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0"
              Visibility="{Binding ShowBottomStatusBar, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ToggleButton x:Name="StatusHistoryButton"
                          Grid.Column="0"
                          Content="{Binding StatusHistoryButtonText}"
                          Padding="8,2" FontSize="11"
                          VerticalAlignment="Center"
                          ToolTip="{Binding StatusHoverSummary}" />
            <Popup PlacementTarget="{Binding ElementName=StatusHistoryButton}"
                   Placement="Top"
                   StaysOpen="False"
                   IsOpen="{Binding Path=IsChecked, ElementName=StatusHistoryButton, Mode=TwoWay}"
                   AllowsTransparency="True">
                <Border Background="#FFFFFFFF" BorderBrush="#FFB0B0B0" BorderThickness="1"
                        Padding="10,8" MinWidth="340" MaxWidth="660" MaxHeight="280">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Main_Status_HistoryTitle}"
                                   FontWeight="Bold" FontSize="12" Margin="0,0,0,6" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="225">
                            <ItemsControl ItemsSource="{Binding StatusHistory}"
                                          Focusable="False" IsHitTestVisible="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayText}"
                                                   TextWrapping="Wrap" Margin="0,2" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FF1E7A1E" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsErrorNotice}" Value="True">
                                                            <Setter Property="Foreground" Value="#FFC00000" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Popup>
            <TextBlock x:Name="StatusText"
                       Grid.Column="1"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="StatusText"
                       Text="{Binding StatusMessage}"
                       ToolTip="{Binding StatusHoverSummary}"
                       FontWeight="Bold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#FF1E7A1E" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="#FFC00000" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- M4-b1 三栏：左 资料库 / 中 当前设备队列 / 右 日志（可隐藏，Ctrl+L） -->
        <Grid x:Name="WorkspaceGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="45*" MinWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="MiddleColumn" Width="27*" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightColumn" Width="28*" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Padding="4" Margin="0,0,0,0">
                <DockPanel>
                    <!-- 2026-11-07 用户定：所有资料库操作集中到一条 WrapPanel，宽屏一行、窄屏自动换行 -->
                    <WrapPanel x:Name="LibraryToolbar" DockPanel.Dock="Top" Orientation="Horizontal"
                               Margin="0,0,0,6" HorizontalAlignment="Stretch"
                               TextElement.FontSize="12" TextElement.FontFamily="Microsoft YaHei UI">
                        <!-- 2026-11-07 用户定：资料库固定最左，设备应用切换紧随其后；
                             两个键用 SharedSizeGroup 按最长文字自动等宽，切换时位置不变。 -->
                        <Grid Grid.IsSharedSizeScope="True" Margin="0,0,6,6" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LeftModeSwitch" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LeftModeSwitch" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="LibraryModeButton" Content="{x:Static res:Strings.Main_Library_ModeTitle}"
                                    FontSize="12" Height="24" Padding="8,0" VerticalAlignment="Center"
                                    FontWeight="Bold" Click="OnLibraryModeClick"
                                    ToolTip="{x:Static res:Strings.Main_Library_ModeTitle}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{x:Static res:Strings.Main_Library_RowHeightSmall}" Click="OnRowHeightSmall" />
                                        <MenuItem Header="{x:Static res:Strings.Main_Library_RowHeightMedium}" Click="OnRowHeightMedium" />
                                        <MenuItem Header="{x:Static res:Strings.Main_Library_RowHeightLarge}" Click="OnRowHeightLarge" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Grid.Column="1" x:Name="DeviceAppsModeButton" Content="{x:Static res:Strings.Main_DeviceApps_ModeTitle}"
                                    FontSize="12" Height="24" Padding="8,0" VerticalAlignment="Center"
                                    IsEnabled="{Binding HasSelectedDevice}"
                                    Click="OnDeviceAppsModeClick"
                                    ToolTip="{x:Static res:Strings.Main_DeviceApps_ModeToolTip}" />
                        </Grid>
                        <Button x:Name="MultiSelectButton" Content="{Binding MultiSelectButtonText}" FontSize="12"
                                Click="OnToggleMultiSelectClick" Height="24" Padding="8,0"
                                Margin="0,0,6,6" VerticalAlignment="Center"
                                ToolTip="{x:Static res:Strings.Main_Library_MultiSelectToolTip}" />
                        <ComboBox x:Name="GroupFilterCombo" MinWidth="84" FontSize="12" Height="24"
                                  VerticalAlignment="Center" Margin="0,0,6,6"
                                  ItemsSource="{Binding GroupFilterOptions}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Name"
                                  SelectedValue="{Binding ActiveGroupName, Mode=TwoWay}"
                                  ToolTip="{x:Static res:Strings.Main_Library_SwitchGroupToolTip}">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                        <Button x:Name="ManageGroupsButton" Content="{x:Static res:Strings.Main_Library_ManageGroups}" FontSize="12"
                                Click="OnManageGroupsClick" Height="24" Padding="8,0"
                                Margin="0,0,6,6" VerticalAlignment="Center"
                                ToolTip="{x:Static res:Strings.Main_Library_ManageGroupsToolTip}" />
                        <Button x:Name="IncrementalScanButton" IsEnabled="{Binding IsLibraryInteractive}" Content="{x:Static res:Strings.Main_Library_IncrementalScan}" FontSize="12" Command="{Binding RescanCommand}"
                                Height="24" Padding="8,0" Margin="0,0,6,6" VerticalAlignment="Center"
                                ToolTip="{x:Static res:Strings.Main_Library_IncrementalScanToolTip}" />
                        <Button x:Name="RescanAllButton" IsEnabled="{Binding IsLibraryInteractive}" Content="{x:Static res:Strings.Main_Library_FullRescan}" FontSize="12" Command="{Binding RescanAllCommand}"
                                Height="24" Padding="8,0" Margin="0,0,6,6" VerticalAlignment="Center"
                                ToolTip="{x:Static res:Strings.Main_Library_FullRescanToolTip}" />
                        <ComboBox x:Name="CompatFilterCombo" FontSize="12" Height="24"
                                  VerticalAlignment="Center" Margin="0,0,6,6"
                                  ItemsSource="{Binding CompatFilterOptions}" DisplayMemberPath="Label"
                                  SelectedValuePath="Mode" SelectedValue="{Binding CompatFilterMode, Mode=TwoWay}"
                                  ToolTip="{x:Static res:Strings.Main_Library_CompatFilterToolTip}" />
                        <Border x:Name="LibrarySearchBorder" Width="136" Height="24"
                                Margin="0,0,6,6" VerticalAlignment="Center"
                                BorderBrush="#FFABADB3" BorderThickness="1" Background="#FFFFFFFF"
                                ToolTip="{x:Static res:Strings.Main_Library_SearchToolTip}">
                            <Grid>
                                <TextBox x:Name="SearchBox" Margin="4,0,18,0" FontSize="12" VerticalContentAlignment="Center"
                                         BorderThickness="0" Background="Transparent"
                                         TextChanged="OnSearchTextChanged" />
                                <Button x:Name="SearchOptionsButton" Content="▾" Width="18" Padding="0"
                                        HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                        Background="Transparent" BorderThickness="0" FontSize="10"
                                        Click="OnSearchOptionsClick" ToolTip="{x:Static res:Strings.Main_Library_SearchOptionsToolTip}">
                                    <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="{x:Static res:Strings.Main_Column_Name}" IsCheckable="True" StaysOpenOnClick="True"
                                              IsChecked="{Binding SearchScope.IsName, Mode=TwoWay}" />
                                    <MenuItem Header="BundleId" IsCheckable="True" StaysOpenOnClick="True"
                                              IsChecked="{Binding SearchScope.IsBundleId, Mode=TwoWay}" />
                                    <MenuItem Header="{x:Static res:Strings.Main_Library_SearchFieldFileName}" IsCheckable="True" StaysOpenOnClick="True"
                                              IsChecked="{Binding SearchScope.IsFileName, Mode=TwoWay}" />
                                    <MenuItem Header="{x:Static res:Strings.Main_Column_Version}" IsCheckable="True" StaysOpenOnClick="True"
                                              IsChecked="{Binding SearchScope.IsVersion, Mode=TwoWay}" />
                                    <MenuItem Header="{x:Static res:Strings.Main_Column_MinOs}" IsCheckable="True" StaysOpenOnClick="True"
                                              IsChecked="{Binding SearchScope.IsMinOs, Mode=TwoWay}" />
                                    <MenuItem Header="{x:Static res:Strings.Main_Column_DeviceFamily}" IsCheckable="True" StaysOpenOnClick="True"
                                              IsChecked="{Binding SearchScope.IsDeviceFamily, Mode=TwoWay}" />
                                    <MenuItem Header="{x:Static res:Strings.Main_Column_Origin}" IsCheckable="True" StaysOpenOnClick="True"
                                              IsChecked="{Binding SearchScope.IsOrigin, Mode=TwoWay}" />
                                    <MenuItem Header="{x:Static res:Strings.Main_Column_Arch}" IsCheckable="True" StaysOpenOnClick="True"
                                              IsChecked="{Binding SearchScope.IsArch, Mode=TwoWay}" />
                                    <MenuItem Header="{x:Static res:Strings.Main_Column_State}" IsCheckable="True" StaysOpenOnClick="True"
                                              IsChecked="{Binding SearchScope.IsState, Mode=TwoWay}" />
                                    <MenuItem Header="{x:Static res:Strings.Main_Column_AppSize}" IsCheckable="True" StaysOpenOnClick="True"
                                              IsChecked="{Binding SearchScope.IsAppSize, Mode=TwoWay}" />
                                    <MenuItem Header="{x:Static res:Strings.Main_Column_FileSize}" IsCheckable="True" StaysOpenOnClick="True"
                                              IsChecked="{Binding SearchScope.IsFileSize, Mode=TwoWay}" />
                                    <MenuItem Header="{x:Static res:Strings.Main_Column_FilePath}" IsCheckable="True" StaysOpenOnClick="True"
                                              IsChecked="{Binding SearchScope.IsFilePath, Mode=TwoWay}" />
                                    <Separator />
                                    <MenuItem Header="{x:Static res:Strings.Main_Search_MatchMode}" IsEnabled="False" />
                                    <MenuItem x:Name="ModeContains" Header="{x:Static res:Strings.Main_Search_ModeContains}" IsCheckable="True" StaysOpenOnClick="True"
                                              Click="OnSearchModeContains" />
                                    <MenuItem x:Name="ModePrefix" Header="{x:Static res:Strings.Main_Search_ModePrefix}" IsCheckable="True" StaysOpenOnClick="True"
                                              Click="OnSearchModePrefix" />
                                    <MenuItem x:Name="ModeExact" Header="{x:Static res:Strings.Main_Search_ModeExact}" IsCheckable="True" StaysOpenOnClick="True"
                                              Click="OnSearchModeExact" />
                                </ContextMenu>
                            </Button.ContextMenu>
                                </Button>
                            </Grid>
                        </Border>
                        <CheckBox x:Name="AdvancedFilterToggle" Height="24" VerticalContentAlignment="Center"
                                  Margin="2,0,2,6" VerticalAlignment="Center"
                                  AutomationProperties.Name="{x:Static res:Strings.Main_Library_AdvancedFilterToggleName}"
                                  IsChecked="{Binding AdvancedFilterEnabled, Mode=TwoWay}"
                                  ToolTip="{x:Static res:Strings.Main_Library_AdvancedFilterToggleToolTip}" />
                        <Button x:Name="AdvancedFilterButton" Content="{Binding AdvancedFilterButtonText}" FontSize="12"
                                Click="OnAdvancedFilterClick" Height="24" Padding="8,0"
                                Margin="0,0,6,6" VerticalAlignment="Center"
                                ToolTip="{x:Static res:Strings.Main_Library_AdvancedFilterToolTip}" />
                        <CheckBox x:Name="MergeCheck" Content="{x:Static res:Strings.Main_Library_MergeSameBundle}" FontSize="12"
                                  IsChecked="{Binding LibraryMergeSameBundle, Mode=TwoWay}"
                                  VerticalContentAlignment="Center" Margin="0,0,6,6"
                                  VerticalAlignment="Center"
                                  ToolTip="{x:Static res:Strings.Main_Library_MergeSameBundleToolTip}" />
                        <TextBlock x:Name="LibraryCount" FontSize="12" Margin="2,0,0,6"
                                   VerticalAlignment="Center" Foreground="#FF666666"
                                   Text="{Binding LibraryCountText}" />
                    </WrapPanel>
                    <!-- 设备应用页独立工具栏：不占用资料库的工具条；多选/批量卸载只作用于当前设备。 -->
                    <WrapPanel x:Name="DeviceAppsToolbar" DockPanel.Dock="Top" Orientation="Horizontal"
                               Margin="0,0,0,6" Visibility="Collapsed"
                               TextElement.FontSize="12" TextElement.FontFamily="Microsoft YaHei UI">
                        <Button x:Name="DeviceAppsMultiSelectButton"
                                Content="{Binding DeviceAppsMultiSelectButtonText}"
                                FontSize="12" Height="24" Padding="8,0" Margin="0,0,6,6"
                                VerticalAlignment="Center"
                                Click="OnToggleDeviceAppsMultiSelectClick"
                                ToolTip="{x:Static res:Strings.Main_DeviceApps_MultiSelectToolTip}" />
                        <Button x:Name="DeviceAppsBatchUninstallButton"
                                Content="{Binding DeviceAppsBatchUninstallText}"
                                FontSize="12" Height="24" Padding="8,0" Margin="0,0,6,6"
                                VerticalAlignment="Center"
                                IsEnabled="{Binding HasSelectedDeviceApps}"
                                Click="OnUninstallSelectedDeviceAppsClick"
                                ToolTip="{x:Static res:Strings.Main_DeviceApps_BatchUninstallToolTip}" />
                        <Button Content="{x:Static res:Strings.Main_Common_SelectAll}" FontSize="12" Height="24" Padding="8,0" Margin="0,0,6,6"
                                VerticalAlignment="Center" Click="OnSelectAllDeviceAppsClick" />
                        <Button Content="{x:Static res:Strings.Main_Common_ClearSelection}" FontSize="12" Height="24" Padding="8,0" Margin="0,0,6,6"
                                VerticalAlignment="Center" Click="OnClearDeviceAppsSelectionClick" />
                        <TextBlock Text="{Binding DeviceAppsCountText}" FontSize="12" Margin="2,0,0,6"
                                   VerticalAlignment="Center" Foreground="#FF666666" />
                    </WrapPanel>
                    <views:AlphabetJumpBar x:Name="JumpBar" DockPanel.Dock="Top" Margin="0,0,0,4" />
                    <Grid>
                    <DataGrid x:Name="LibraryGrid"
                              UseLayoutRounding="True"
                              SnapsToDevicePixels="True"
                              IsEnabled="{Binding IsLibraryInteractive}"
                              ItemsSource="{Binding LibraryRows}"
                              SelectedItem="{Binding SelectedLibraryRow, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              HeadersVisibility="Column" RowHeight="{Binding LibraryRowHeight}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FFC8C8C8"
                               RowStyle="{StaticResource LibraryRowStyle}"
                               CellStyle="{StaticResource LibraryCellStyle}"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              SelectionChanged="OnLibrarySelectionChanged"
                              Sorting="OnLibrarySorting"
                              PreviewMouseLeftButtonDown="OnLibraryPreviewMouseLeftButtonDown"
                              PreviewMouseMove="OnLibraryPreviewMouseMove"
                              PreviewMouseLeftButtonUp="OnLibraryPreviewMouseLeftButtonUp"
                              PreviewMouseRightButtonDown="OnLibraryPreviewMouseRightButtonDown"
                              PreviewMouseWheel="OnGridPreviewMouseWheel"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.ContextMenu>
                            <ContextMenu x:Name="SingleLibraryContextMenu" PreviewKeyDown="OnContextMenuPreviewKeyDown">
                                <MenuItem x:Name="SingleForceInstallMenu"
                                          Header="{x:Static res:Strings.Main_Menu_ForceInstall}"
                                          Tag="I"
                                          Click="OnForceInstallClick" />
                                <Separator />
                                <MenuItem x:Name="SingleCopyParentMenu"
                                          Header="{x:Static res:Strings.Main_Menu_Copy}"
                                          Tag="C">
                                    <MenuItem Header="{x:Static res:Strings.Main_Menu_CopyBundleId}" Tag="B" Click="OnCopyBundleId" />
                                    <MenuItem Header="{x:Static res:Strings.Main_Menu_CopyName}" Tag="N" Click="OnCopyName" />
                                    <MenuItem Header="{x:Static res:Strings.Main_Menu_CopyVersion}" Tag="V" Click="OnCopyVersion" />
                                    <MenuItem Header="{x:Static res:Strings.Main_Menu_CopyMinOs}" Tag="O" Click="OnCopyMinOs" />
                                    <Separator />
                                    <MenuItem x:Name="SingleCopyFileNameMenu" Header="{x:Static res:Strings.Main_Menu_CopyFileName}" Tag="F" Click="OnCopyFileName" />
                                    <MenuItem x:Name="SingleCopyFilePathMenu" Header="{x:Static res:Strings.Main_Menu_CopyFilePath}" Tag="P" Click="OnCopyFilePath" />
                                    <Separator />
                                    <MenuItem Header="{x:Static res:Strings.Main_Menu_CopyRow}" Tag="R" Click="OnCopyRow" />
                                </MenuItem>
                                <MenuItem x:Name="SingleOpenFilePathMenu"
                                          Header="{x:Static res:Strings.Main_Menu_OpenFilePath}"
                                          Tag="E"
                                          Click="OnOpenFilePath"
                                          ToolTip="{x:Static res:Strings.Main_Menu_OpenFilePathToolTip}" />
                                <Separator />
                                <MenuItem x:Name="SingleJoinGroupMenu" Header="{x:Static res:Strings.Main_Menu_AddToGroup}" Tag="G" />
                                <MenuItem x:Name="SingleNewGroupMenu" Header="{x:Static res:Strings.Main_Menu_NewGroup}" Tag="W" Click="OnNewGroupClick" />
                                <MenuItem x:Name="SingleManageGroupsMenu" Header="{x:Static res:Strings.Main_Menu_ManageGroups}" Tag="M" Click="OnManageGroupsClick" />
                                <MenuItem x:Name="SingleRemoveGroupMenu" Header="{x:Static res:Strings.Main_Menu_RemoveFromGroup}" Tag="X"
                                          Click="OnRemoveFromGroupClick" />
                                <Separator />
                                <MenuItem Header="{Binding MissingFilterMenuText}" Tag="H" Click="OnToggleMissingClick" />
                                <MenuItem Header="{x:Static res:Strings.Main_Menu_DeleteMissingRecords}" Tag="D" Click="OnDeleteMissingRecordsClick" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                    <DataGrid x:Name="DeviceAppsGrid" Visibility="Collapsed"
                              ItemsSource="{Binding DeviceApps}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              CanUserReorderColumns="True" CanUserResizeColumns="True"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              HeadersVisibility="Column" RowHeight="32"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FFC8C8C8"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              RowStyle="{StaticResource DeviceAppRowStyle}"
                              CellStyle="{StaticResource DeviceAppCellStyle}"
                              PreviewMouseLeftButtonDown="OnDeviceAppsPreviewMouseLeftButtonDown"
                              PreviewMouseMove="OnDeviceAppsPreviewMouseMove"
                              PreviewMouseLeftButtonUp="OnDeviceAppsPreviewMouseLeftButtonUp"
                              PreviewMouseRightButtonDown="OnDeviceAppsPreviewMouseRightButtonDown"
                              PreviewMouseWheel="OnGridPreviewMouseWheel">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{x:Static res:Strings.Main_Column_Icon}" Width="40" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding Icon}" Width="28" Height="28"
                                               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{x:Static res:Strings.Main_Column_Name}" Width="*" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource DeviceAppTextStyle}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{x:Static res:Strings.Main_Column_Version}" Width="90" SortMemberPath="VersionText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding VersionText}"
                                                   Style="{StaticResource DeviceAppTextStyle}"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="BundleId" Width="220" SortMemberPath="BundleId">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding BundleId}"
                                                   Style="{StaticResource DeviceAppTextStyle}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <!-- 扫描期间占位：不逐批 Build，扫描结束一次性显示（2026-11-08 用户定） -->
                    <Border Background="#F5F7FA" Panel.ZIndex="10"
                            Visibility="{Binding IsLibraryScanOverlayVisible, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ScanProgressText}" FontSize="14" Foreground="#FF555555"
                                       HorizontalAlignment="Center" />
                            <ProgressBar IsIndeterminate="True" Width="260" Height="4" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                    </Grid>
                </DockPanel>
            </GroupBox>

            <GridSplitter x:Name="LeftSplitter" Grid.Column="1" Width="5"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          Background="#FFC8C8C8" MouseDoubleClick="OnSplitterDoubleClick" />

            <GroupBox Grid.Column="2" Padding="4" Margin="0,0,0,0"
                      Header="{Binding SelectedDevice.QueueHeader, FallbackValue={x:Static res:Strings.Main_Queue_NoDeviceHeader}, TargetNullValue={x:Static res:Strings.Main_Queue_NoDeviceHeader}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button x:Name="QueueSuspendButton"
                                Content="{Binding SelectedDevice.SuspendResumeText, FallbackValue={x:Static res:Strings.Main_Queue_SuspendFallback}, TargetNullValue={x:Static res:Strings.Main_Queue_SuspendFallback}}"
                                Command="{Binding SelectedDevice.ToggleSuspendCommand}"
                                IsEnabled="{Binding HasSelectedDevice}" Padding="10,2"
                                ToolTip="{x:Static res:Strings.Main_Queue_SuspendResumeToolTip}" />
                        <Button x:Name="QueueCancelButton"
                                Content="{x:Static res:Strings.Main_Queue_Cancel}"
                                Command="{Binding SelectedDevice.CancelSelectedCommand}"
                                IsEnabled="{Binding HasSelectedDevice}" Padding="10,2" Margin="6,0,0,0"
                                ToolTip="{x:Static res:Strings.Main_Queue_CancelToolTip}" />
                        <!-- 清除（2026-11-02 用户定）：原资料库 ⟳ 搬到这里，文案「清除」；只作用于当前设备 -->
                        <Button x:Name="ClearQueueButton" Content="{x:Static res:Strings.Main_Queue_Clear}" Click="OnClearMarksClick"
                                IsEnabled="{Binding HasSelectedDevice}"
                                Padding="10,2" Margin="6,0,0,0"
                                ToolTip="{x:Static res:Strings.Main_Queue_ClearToolTip}" />
                        <TextBlock Text="{Binding SelectedDevice.SpaceAfterText}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11"
                                   AutomationProperties.AutomationId="QueueSpaceAfterText"
                                   ToolTip="{x:Static res:Strings.Main_Queue_SpaceAfterToolTip}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FF666666" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDevice.IsSpaceAfterLow}" Value="True">
                                            <Setter Property="Foreground" Value="#FFD32F2F" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Grid>
                        <ListBox x:Name="QueueList"
                                 ItemsSource="{Binding SelectedDevice.Jobs}" DisplayMemberPath="Display"
                                 ItemContainerStyle="{StaticResource QueueItemStyle}"
                                 SelectedItem="{Binding SelectedDevice.SelectedJob, Mode=TwoWay}"
                                 PreviewMouseLeftButtonDown="OnQueuePreviewMouseLeftButtonDown" />
                        <TextBlock x:Name="QueueEmptyHintText"
                                   IsHitTestVisible="False"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="24,12" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="#FF888888" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Text" Value="{x:Static res:Strings.Main_Queue_EmptyHint}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedDevice}" Value="False">
                                            <Setter Property="Text" Value="{x:Static res:Strings.Main_Queue_NoDeviceHint}" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasSelectedDevice}" Value="True" />
                                                <Condition Binding="{Binding Items.Count, ElementName=QueueList}" Value="0" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="{x:Static res:Strings.Main_Queue_EmptyHint}" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </GroupBox>

            <GridSplitter x:Name="RightSplitter" Grid.Column="3" Width="5"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          Background="#FFC8C8C8" MouseDoubleClick="OnSplitterDoubleClick" />

            <GroupBox x:Name="LogGroup" Grid.Column="4" Padding="4">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static res:Strings.Main_Log_Title}" VerticalAlignment="Center" />
                        <Button Content="{Binding LogModeButtonText}" Command="{Binding ToggleLogModeCommand}"
                                Padding="8,1" Margin="10,0,0,0" FontSize="11"
                                ToolTip="{x:Static res:Strings.Main_Log_ModeToolTip}" />
                        <Button Content="{x:Static res:Strings.Main_Log_Export}" Click="OnExportLogClick"
                                Padding="8,1" Margin="6,0,0,0" FontSize="11"
                                ToolTip="{x:Static res:Strings.Main_Log_ExportToolTip}" />
                        <Button Content="{x:Static res:Strings.Main_Log_Clear}" Click="OnClearLogClick"
                                AutomationProperties.AutomationId="LogClearButton"
                                Padding="8,1" Margin="6,0,0,0" FontSize="11"
                                ToolTip="{x:Static res:Strings.Main_Log_ClearToolTip}" />
                    </StackPanel>
                </GroupBox.Header>
                <ListBox x:Name="LogList"
                         ItemsSource="{Binding LogLines}"
                         FontFamily="Consolas" FontSize="12"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <!-- b3b：Error 整行红、End 整行绿（触发器绑 bool 属性，不赌 internal enum 的字符串转换） -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="#FFC62828" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEnd}" Value="True">
                                    <Setter Property="Foreground" Value="#FF2E7D32" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <!-- 长行按列宽省略；全文在 ToolTip（LogLine.ToolTipText） -->
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
