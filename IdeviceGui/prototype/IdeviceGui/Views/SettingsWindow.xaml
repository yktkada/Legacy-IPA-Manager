<Window x:Class="IdeviceGui.Views.SettingsWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:IdeviceGui.Resources"
        Title="{x:Static res:Strings.Settings_Title}" Width="620" Height="660" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AutomationProperties.AutomationId="SettingsWindow">
    <!-- 生效方式（2026-11-02 用户定）：窗口内即时预览，点「确定 / 应用」才写库，「取消 / 关窗」回滚。
         例外（2026-11-03 审查 N2）：扫描根添加/删除、列宽复位是**立即生效的动作**，不受「取消」影响。 -->
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="GroupResetButton" TargetType="Button">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="OkButton" Content="{x:Static res:Strings.Settings_Button_Ok}" Width="76" Padding="0,3" Click="OnOkClick" IsDefault="True" />
            <Button x:Name="ApplyButton" Content="{x:Static res:Strings.Settings_Button_Apply}" Width="76" Padding="0,3" Margin="8,0,0,0" Click="OnApplyClick" />
            <Button x:Name="CancelButton" Content="{x:Static res:Strings.Settings_Button_Cancel}" Width="76" Padding="0,3" Margin="8,0,0,0" Click="OnCancelClick" IsCancel="True" />
        </StackPanel>

        <TabControl x:Name="Tabs" AutomationProperties.AutomationId="SettingsTabs">
            <!-- 资料库 -->
            <TabItem Header="{x:Static res:Strings.Settings_Tab_Library}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <Button Content="{x:Static res:Strings.Settings_Button_ResetGroup}" Style="{StaticResource GroupResetButton}" Tag="Library" Click="OnResetGroupClick" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="155" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static res:Strings.Settings_Library_RowHeight}" Style="{StaticResource RowLabel}" />
                            <Slider x:Name="RowHeightSlider" Grid.Column="1" Minimum="16" Maximum="48"
                                    TickFrequency="2" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    ValueChanged="OnRowHeightSliderChanged" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBox x:Name="RowHeightBox" Width="52" TextChanged="OnAnyChanged" LostFocus="OnNumericLostFocus"
                                         ToolTip="{x:Static res:Strings.Settings_Library_RowHeightToolTip}" />
                                <TextBlock Text="DIP" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="155" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static res:Strings.Settings_Library_SearchRows}" Style="{StaticResource RowLabel}" />
                            <TextBox x:Name="SearchRowsBox" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                     TextChanged="OnAnyChanged" LostFocus="OnNumericLostFocus"
                                     ToolTip="{x:Static res:Strings.Settings_Library_SearchRowsToolTip}" />
                            <TextBlock Grid.Column="2" Text="{x:Static res:Strings.Settings_Library_SearchRowsUnit}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="155" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static res:Strings.Settings_Library_SearchDelay}" Style="{StaticResource RowLabel}" />
                            <TextBox x:Name="SearchDelayBox" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                     TextChanged="OnAnyChanged" LostFocus="OnNumericLostFocus"
                                     ToolTip="{x:Static res:Strings.Settings_Library_SearchDelayToolTip}" />
                            <TextBlock Grid.Column="2" Text="ms" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="155" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static res:Strings.Settings_Library_DefaultSort}" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="SortFieldCombo" Grid.Column="1" SelectionChanged="OnAnyChanged" />
                            <CheckBox x:Name="SortDescendingCheck" Grid.Column="2" Content="{x:Static res:Strings.Settings_Library_SortDescending}"
                                      VerticalAlignment="Center" Margin="8,0,0,0" Click="OnAnyChanged" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="155" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static res:Strings.Settings_Library_MatchMode}" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="MatchModeCombo" Grid.Column="1" SelectionChanged="OnAnyChanged" />
                        </Grid>
                        <TextBlock Text="{x:Static res:Strings.Settings_Library_SearchScope}" Style="{StaticResource SectionTitle}" />
                        <WrapPanel x:Name="ScopePanel" Orientation="Horizontal" />
                        <TextBlock Text="{x:Static res:Strings.Settings_Library_Behavior}" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="MergeCheck" Content="{x:Static res:Strings.Settings_Library_MergeSameBundle}" Margin="0,2,0,2" Click="OnAnyChanged" />
                        <CheckBox x:Name="MissingCheck" Content="{x:Static res:Strings.Settings_Library_ShowMissingFiles}" Margin="0,2,0,2" Click="OnAnyChanged" />
                        <CheckBox x:Name="DeviceFamilyRetinaCheck" Content="{x:Static res:Strings.Settings_Library_DeviceFamilyRetina}" Margin="0,8,0,2" Click="OnAnyChanged" />
                        <TextBlock Text="{x:Static res:Strings.Settings_Library_ColumnsSection}" Style="{StaticResource SectionTitle}" />
                        <WrapPanel x:Name="ColumnsPanel" Orientation="Horizontal" />
                        <Button Content="{x:Static res:Strings.Settings_Library_ManageGroups}" Padding="10,3" HorizontalAlignment="Left"
                                Margin="0,12,0,0" Click="OnManageGroupsSettingsClick" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 扫描 -->
            <TabItem Header="{x:Static res:Strings.Settings_Tab_Scan}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <Button Content="{x:Static res:Strings.Settings_Button_ResetGroup}" Style="{StaticResource GroupResetButton}" Tag="Scan" Click="OnResetGroupClick" />
                        <TextBlock Text="{x:Static res:Strings.Settings_Scan_RootsSection}" Style="{StaticResource SectionTitle}" />
                        <ListBox x:Name="RootsList" Height="180" AutomationProperties.AutomationId="SettingsRootsList" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="{x:Static res:Strings.Settings_Scan_AddFolder}" Padding="10,3" Click="OnAddRootClick"
                                    ToolTip="{x:Static res:Strings.Settings_Scan_AddFolderToolTip}" />
                            <Button Content="{x:Static res:Strings.Settings_Scan_DeleteSelected}" Padding="10,3" Margin="8,0,0,0" Click="OnDeleteRootClick"
                                    ToolTip="{x:Static res:Strings.Settings_Scan_DeleteSelectedToolTip}" />
                            <TextBlock x:Name="RootsHint" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#FF666666" />
                        </StackPanel>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="155" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static res:Strings.Settings_Scan_BatchSize}" Style="{StaticResource RowLabel}" />
                            <TextBox x:Name="BatchSizeBox" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                     TextChanged="OnAnyChanged" LostFocus="OnNumericLostFocus"
                                     ToolTip="{x:Static res:Strings.Settings_Scan_BatchSizeToolTip}" />
                        </Grid>
                        <CheckBox x:Name="SkipStartupScanCheck"
                                  Content="{x:Static res:Strings.Settings_Scan_SkipStartup}"
                                  Margin="0,10,0,0"
                                  Click="OnAnyChanged" />
                        <TextBlock Text="{x:Static res:Strings.Settings_Scan_SkipStartupNote}"
                                   Margin="20,4,0,0" TextWrapping="Wrap" Foreground="#FF666666" />
                        <TextBlock Text="{x:Static res:Strings.Settings_Scan_Note}"
                                   Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FF666666" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 图标 -->
            <TabItem Header="{x:Static res:Strings.Settings_Tab_Icons}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <Button Content="{x:Static res:Strings.Settings_Button_ResetGroup}" Style="{StaticResource GroupResetButton}" Tag="Icons" Click="OnResetGroupClick" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static res:Strings.Settings_Icons_CacheLimit}" Style="{StaticResource RowLabel}" />
                            <TextBox x:Name="CacheMaxBox" Grid.Column="1" Width="110" HorizontalAlignment="Left"
                                     TextChanged="OnAnyChanged" LostFocus="OnNumericLostFocus"
                                     ToolTip="{x:Static res:Strings.Settings_Icons_CacheLimitToolTip}" />
                        </Grid>
                        <CheckBox x:Name="IconMatchScaleCheck" Content="{x:Static res:Strings.Settings_Icons_MatchScale}"
                                  Margin="0,10,0,2" Click="OnAnyChanged" />
                        <CheckBox x:Name="IconDownscaleCheck" Content="{x:Static res:Strings.Settings_Icons_DownscaleCache}"
                                  Margin="0,2,0,2" Click="OnAnyChanged" />
                        <TextBlock x:Name="IconBucketHint" Margin="0,10,0,0" Foreground="#FF666666" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 日志 -->
            <TabItem Header="{x:Static res:Strings.Settings_Tab_Log}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <Button Content="{x:Static res:Strings.Settings_Button_ResetGroup}" Style="{StaticResource GroupResetButton}" Tag="Log" Click="OnResetGroupClick" />
                        <CheckBox x:Name="LogToFileCheck" Content="{x:Static res:Strings.Settings_Log_ToFile}"
                                  Margin="0,6,0,2" Click="OnAnyChanged" />
                        <CheckBox x:Name="LogDetailCheck" Content="{x:Static res:Strings.Settings_Log_DetailMode}"
                                  Margin="0,2,0,2" Click="OnAnyChanged" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 布局 -->
            <TabItem Header="{x:Static res:Strings.Settings_Tab_Layout}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <Button Content="{x:Static res:Strings.Settings_Button_ResetGroup}" Style="{StaticResource GroupResetButton}" Tag="Layout" Click="OnResetGroupClick" />
                        <CheckBox x:Name="LogHiddenCheck" Content="{x:Static res:Strings.Settings_Layout_HideLog}" Margin="0,6,0,2" Click="OnAnyChanged" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static res:Strings.Settings_Layout_OverlayWidth}" Style="{StaticResource RowLabel}" />
                            <TextBox x:Name="OverlayWidthBox" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                     TextChanged="OnAnyChanged" LostFocus="OnNumericLostFocus"
                                     ToolTip="{x:Static res:Strings.Settings_Layout_OverlayWidthToolTip}" />
                        </Grid>
                        <Button Content="{x:Static res:Strings.Settings_Layout_ResetColumns}" Padding="10,3" Margin="0,14,0,0" HorizontalAlignment="Left"
                                Click="OnResetColumnsClick"
                                ToolTip="{x:Static res:Strings.Settings_Layout_ResetColumnsToolTip}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static res:Strings.Settings_Layout_Language}" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="160" HorizontalAlignment="Left"
                                      SelectionChanged="OnAnyChanged"
                                      ToolTip="{x:Static res:Strings.Settings_Layout_Language_Tooltip}">
                                <ComboBoxItem Content="{x:Static res:Strings.Settings_Layout_Language_System}" Tag="system" />
                                <ComboBoxItem Content="{x:Static res:Strings.Settings_Layout_Language_ZhCn}" Tag="zh-CN" />
                                <ComboBoxItem Content="{x:Static res:Strings.Settings_Layout_Language_En}" Tag="en" />
                            </ComboBox>
                        </Grid>
                        <TextBlock Text="{x:Static res:Strings.Settings_Layout_Language_RestartHint}"
                                   Foreground="#666" FontSize="11" Margin="150,4,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 队列 -->
            <TabItem Header="{x:Static res:Strings.Settings_Tab_Queue}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <Button Content="{x:Static res:Strings.Settings_Button_ResetGroup}" Style="{StaticResource GroupResetButton}" Tag="Queue" Click="OnResetGroupClick" />
                        <TextBlock Text="{x:Static res:Strings.Settings_Queue_FieldsSection}" Style="{StaticResource SectionTitle}" />
                        <ListBox x:Name="QueueFieldsList" Height="260"
                                 AutomationProperties.AutomationId="SettingsQueueFieldsList">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding Visible, Mode=TwoWay}"
                                              Click="OnQueueFieldCheckChanged" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="{x:Static res:Strings.Settings_Button_MoveUp}" Padding="10,3" Click="OnQueueFieldUpClick" />
                            <Button Content="{x:Static res:Strings.Settings_Button_MoveDown}" Padding="10,3" Margin="8,0,0,0" Click="OnQueueFieldDownClick" />
                        </StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Settings_Queue_FieldsNote}"
                                   TextWrapping="Wrap" Foreground="#FF666666" Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 设备 -->
            <TabItem Header="{x:Static res:Strings.Settings_Tab_Device}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <Button Content="{x:Static res:Strings.Settings_Button_ResetGroup}" Style="{StaticResource GroupResetButton}" Tag="Device" Click="OnResetGroupClick" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static res:Strings.Settings_Device_PollSeconds}" Style="{StaticResource RowLabel}" />
                            <TextBox x:Name="PollSecondsBox" Grid.Column="1" Width="70" HorizontalAlignment="Left"
                                     TextChanged="OnAnyChanged" LostFocus="OnNumericLostFocus"
                                     ToolTip="{x:Static res:Strings.Settings_Device_PollSecondsToolTip}" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static res:Strings.Settings_Device_StableSeconds}" Style="{StaticResource RowLabel}" />
                            <TextBox x:Name="StableSecondsBox" Grid.Column="1" Width="70" HorizontalAlignment="Left"
                                     TextChanged="OnAnyChanged" LostFocus="OnNumericLostFocus"
                                     ToolTip="{x:Static res:Strings.Settings_Device_StableSecondsToolTip}" />
                        </Grid>
                        <CheckBox x:Name="AutoResumeCheck" Content="{x:Static res:Strings.Settings_Device_AutoResume}" Margin="0,10,0,2" Click="OnAnyChanged" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static res:Strings.Settings_Device_AutoRetryAttempts}" Style="{StaticResource RowLabel}" />
                            <TextBox x:Name="AutoRetryAttemptsBox" Grid.Column="1" Width="70" HorizontalAlignment="Left"
                                     TextChanged="OnAnyChanged" LostFocus="OnNumericLostFocus"
                                     ToolTip="{x:Static res:Strings.Settings_Device_AutoRetryAttemptsToolTip}" />
                        </Grid>
                        <TextBlock Text="{x:Static res:Strings.Settings_Device_FieldsSection}" Style="{StaticResource SectionTitle}" />
                        <ListBox x:Name="FieldsList" Height="180" AutomationProperties.AutomationId="SettingsFieldsList">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding Visible, Mode=TwoWay}"
                                              Click="OnFieldCheckChanged" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="{x:Static res:Strings.Settings_Button_MoveUp}" Padding="10,3" Click="OnFieldUpClick" />
                            <Button Content="{x:Static res:Strings.Settings_Button_MoveDown}" Padding="10,3" Margin="8,0,0,0" Click="OnFieldDownClick" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 安全（docs/12 §3.4.2） -->
            <TabItem Header="{x:Static res:Strings.Settings_Tab_Security}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <Button Content="{x:Static res:Strings.Settings_Button_ResetGroup}" Style="{StaticResource GroupResetButton}" Tag="Security" Click="OnResetGroupClick" />
                        <CheckBox x:Name="AllowOutsideWriteCheck"
                                  Content="{x:Static res:Strings.Settings_Security_AllowOutsideWrite}"
                                  Margin="0,4,0,0"
                                  Click="OnAllowOutsideWriteClick" />
                        <TextBlock Text="{x:Static res:Strings.Settings_Security_ReadOnlyNote}"
                                   TextWrapping="Wrap" Foreground="#FF555555" Margin="20,6,0,0" LineHeight="18" />
                        <TextBlock Text="{x:Static res:Strings.Settings_Security_RiskNote}"
                                   TextWrapping="Wrap" Foreground="#FFB25000" Margin="20,8,0,0" LineHeight="18" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 关于：固定英文，不参与应用 / 取消 / 恢复默认（2026-11-08） -->
            <TabItem Header="{x:Static res:Strings.Settings_Tab_About}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <TextBlock Text="Legacy IPA Manager for Windows"
                                   FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="IPA Library &amp; Installer for Legacy iOS Devices"
                                   Margin="0,4,0,12" Foreground="#FF555555" TextWrapping="Wrap" />
                        <TextBlock TextWrapping="Wrap" LineHeight="20">
                            A powerful IPA library manager and installer for legacy iOS devices on Windows.
                        </TextBlock>
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="20">
                            Performance-tested with a 50,000+ IPA library.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" LineHeight="20">Advanced compatibility filtering.</TextBlock>
                        <TextBlock TextWrapping="Wrap" LineHeight="20">Intelligent multi-device installation queues.</TextBlock>
                        <TextBlock x:Name="AboutVersionText" Margin="0,16,0,0" TextWrapping="Wrap" />
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="20">
                            Supported: iOS 4 / 6 / 7 / 8 and iPad.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" LineHeight="20">Newer iOS devices are not officially supported.</TextBlock>
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="20">
                            Unofficial third-party tool. Not affiliated with Apple Inc.
                        </TextBlock>
                        <TextBlock Margin="0,12,0,0" Text="License: GPL-2.0-or-later · aria2 1.37.0 (GPL-2.0)" TextWrapping="Wrap" />
                        <Button Content="{x:Static res:Strings.Settings_About_LicensesButton}" Margin="0,8,0,0"
                                HorizontalAlignment="Left" Padding="10,4" Click="OnOpenLicensesClick" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
