<Window x:Class="IdeviceIndex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IdeviceIndex"
        xmlns:res="clr-namespace:IdeviceIndex.Resources"
        Title="{x:Static res:Strings.Window_Title}"
        Width="1280" Height="780"
        MinWidth="740" MinHeight="560"
        Icon="pack://application:,,,/IdeviceIndex;component/app.ico"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="SelectedRowBrush" Color="#FFE6E6E6" />
        <SolidColorBrush x:Key="InstalledRowBrush" Color="#FFD9F2D9" />
        <SolidColorBrush x:Key="ArmedRowBrush" Color="#FF2F6FD0" />
        <SolidColorBrush x:Key="FailedRowBrush" Color="#FFFFD9D9" />
        <SolidColorBrush x:Key="InstallWaitingRowBrush" Color="#FFB4D2F0" />
        <SolidColorBrush x:Key="InstallActiveRowBrush" Color="#FF7FA9DC" />
        <SolidColorBrush x:Key="PausedRowBrush" Color="#FFD0D0D0" />

        <DataTemplate x:Key="IconCellTemplate">
            <Image Source="{Binding Icon}" Width="24" Height="24"
                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        </DataTemplate>

        <!-- 对照复制自 IdeviceGui\Views\MainWindow.xaml DeviceAppRowStyle / DeviceAppCellStyle / DeviceAppTextStyle -->
        <Style x:Key="IndexRowStyle" TargetType="DataGridRow">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedRowBrush}" />
                    <Setter Property="Foreground" Value="#FF000000" />
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsGroup}" Value="False" />
                        <Condition Binding="{Binding Visual}" Value="Failed" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource FailedRowBrush}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsGroup}" Value="False" />
                        <Condition Binding="{Binding Visual}" Value="Active" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource InstallActiveRowBrush}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsGroup}" Value="False" />
                        <Condition Binding="{Binding Visual}" Value="Paused" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource PausedRowBrush}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsGroup}" Value="False" />
                        <Condition Binding="{Binding Visual}" Value="Waiting" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource InstallWaitingRowBrush}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsGroup}" Value="False" />
                        <Condition Binding="{Binding Visual}" Value="Succeeded" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource InstalledRowBrush}" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                    <Setter Property="BorderBrush" Value="#FFC8C8C8" />
                    <Setter Property="BorderThickness" Value="0,1,0,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsGroupEnd}" Value="True">
                    <Setter Property="BorderBrush" Value="#FFC8C8C8" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsGroup}" Value="True" />
                        <Condition Binding="{Binding IsGroupEnd}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderThickness" Value="0,1,0,1" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsArmed}" Value="True">
                    <Setter Property="Background" Value="{StaticResource ArmedRowBrush}" />
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource ArmedRowBrush}" />
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IndexCellStyle" TargetType="DataGridCell">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="TextElement.Foreground" Value="#FF000000" />
            <Setter Property="BorderBrush" Value="#FFC8C8C8" />
            <Setter Property="BorderThickness" Value="0,0,0.5,0" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#FF000000" />
                    <Setter Property="TextElement.Foreground" Value="#FF000000" />
                </Trigger>
                <DataTrigger Binding="{Binding IsArmed}" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                    <Setter Property="TextElement.Foreground" Value="#FFFFFFFF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                    <Setter Property="TextElement.Foreground" Value="#FFFFFFFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IndexTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="4,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsArmed}" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 对照复制自 IdeviceGui\Views\MainWindow.xaml QueueItemStyle -->
        <Style x:Key="QueueItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Background" Value="{Binding RowBrush}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedRowBrush}" />
                    <Setter Property="Foreground" Value="#FF000000" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <Border DockPanel.Dock="Top" Padding="0,0,0,8">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{x:Static res:Strings.Toolbar_Search}" VerticalAlignment="Center" Margin="0,0,6,4" />
                <Border x:Name="SearchBorder" Width="220" Height="24" Margin="0,0,6,4"
                        BorderBrush="#FFABADB3" BorderThickness="1" Background="#FFFFFFFF"
                        ToolTip="{x:Static res:Strings.Toolbar_SearchToolTip}">
                    <Grid>
                        <TextBox x:Name="SearchBox" Margin="4,0,20,0" VerticalContentAlignment="Center"
                                 BorderThickness="0" Background="Transparent"
                                 TextChanged="OnSearchTextChanged" />
                        <Button x:Name="SearchOptionsButton" Content="▾" Width="20" Padding="0"
                                HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                Background="Transparent" BorderThickness="0" FontSize="11"
                                Click="OnSearchOptionsClick"
                                ToolTip="{x:Static res:Strings.Search_OptionsToolTip}">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="SearchOptionsMenu">
                                    <MenuItem Header="{x:Static res:Strings.Column_Title}" IsCheckable="True" StaysOpenOnClick="True"
                                              IsChecked="{Binding IsTitle, Mode=TwoWay}" />
                                    <MenuItem Header="BundleId" IsCheckable="True" StaysOpenOnClick="True"
                                              IsChecked="{Binding IsBundleId, Mode=TwoWay}" />
                                    <MenuItem Header="{x:Static res:Strings.Column_Version}" IsCheckable="True" StaysOpenOnClick="True"
                                              IsChecked="{Binding IsVersion, Mode=TwoWay}" />
                                    <MenuItem Header="{x:Static res:Strings.Column_MinOs}" IsCheckable="True" StaysOpenOnClick="True"
                                              IsChecked="{Binding IsMinOs, Mode=TwoWay}" />
                                    <MenuItem Header="{x:Static res:Strings.Column_Category}" IsCheckable="True" StaysOpenOnClick="True"
                                              IsChecked="{Binding IsCategory, Mode=TwoWay}" />
                                    <MenuItem Header="{x:Static res:Strings.Filter_Col_Developer}" IsCheckable="True" StaysOpenOnClick="True"
                                              IsChecked="{Binding IsDeveloper, Mode=TwoWay}" />
                                    <MenuItem Header="{x:Static res:Strings.Filter_Col_Description}" IsCheckable="True" StaysOpenOnClick="True"
                                              IsChecked="{Binding IsDescription, Mode=TwoWay}" />
                                    <MenuItem Header="{x:Static res:Strings.Filter_Col_Source}" IsCheckable="True" StaysOpenOnClick="True"
                                              IsChecked="{Binding IsSource, Mode=TwoWay}" />
                                    <Separator />
                                    <MenuItem Header="{x:Static res:Strings.Search_MatchModeHeader}" IsEnabled="False" />
                                    <MenuItem x:Name="ModeContains" Header="{x:Static res:Strings.Search_ModeContains}" IsCheckable="True" StaysOpenOnClick="True"
                                              Click="OnSearchModeContains" />
                                    <MenuItem x:Name="ModePrefix" Header="{x:Static res:Strings.Search_ModePrefix}" IsCheckable="True" StaysOpenOnClick="True"
                                              Click="OnSearchModePrefix" />
                                    <MenuItem x:Name="ModeExact" Header="{x:Static res:Strings.Search_ModeExact}" IsCheckable="True" StaysOpenOnClick="True"
                                              Click="OnSearchModeExact" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                </Border>

                <CheckBox x:Name="AdvancedFilterToggle" Height="24" VerticalContentAlignment="Center"
                          Margin="0,0,4,4" VerticalAlignment="Center"
                          AutomationProperties.Name="{x:Static res:Strings.Filter_ToggleName}"
                          Checked="OnAdvancedFilterToggleChanged" Unchecked="OnAdvancedFilterToggleChanged"
                          ToolTip="{x:Static res:Strings.Filter_ToggleToolTip}" />
                <Button x:Name="AdvancedFilterButton" Content="{x:Static res:Strings.Filter_Button}"
                        Height="24" Padding="8,0" Margin="0,0,10,4"
                        Click="OnAdvancedFilterClick"
                        ToolTip="{x:Static res:Strings.Filter_ButtonToolTip}" />

                <TextBlock Text="{x:Static res:Strings.Toolbar_Device}" VerticalAlignment="Center" Margin="0,0,6,4" />
                <ComboBox x:Name="DeviceFilter" Width="84" Height="24" SelectedIndex="0" Margin="0,0,10,4"
                          SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="{x:Static res:Strings.Filter_Device_All}" Tag="0" />
                    <ComboBoxItem Content="iPhone" Tag="2" />
                    <ComboBoxItem Content="iPad" Tag="4" />
                </ComboBox>

                <TextBlock Text="{x:Static res:Strings.Toolbar_MinIos}" VerticalAlignment="Center" Margin="0,0,6,4" />
                <ComboBox x:Name="MinOsOpCombo" Width="46" Height="24" SelectedIndex="0" Margin="0,0,4,4"
                          SelectionChanged="OnMinOsOpChanged"
                          ToolTip="{x:Static res:Strings.MinOs_OperatorToolTip}">
                    <ComboBoxItem Content="≤" Tag="LessOrEqual" />
                    <ComboBoxItem Content="&lt;" Tag="Less" />
                    <ComboBoxItem Content="=" Tag="Equal" />
                    <ComboBoxItem Content="≥" Tag="GreaterOrEqual" />
                    <ComboBoxItem Content="&gt;" Tag="Greater" />
                </ComboBox>
                <Border x:Name="MinOsBorder" Width="104" Height="24" Margin="0,0,10,4"
                        BorderBrush="#FFABADB3" BorderThickness="1" Background="#FFFFFFFF"
                        ToolTip="{x:Static res:Strings.MinOs_InputToolTip}">
                    <Grid>
                        <TextBox x:Name="MinOsBox" Margin="4,0,20,0" VerticalContentAlignment="Center"
                                 BorderThickness="0" Background="Transparent"
                                 TextChanged="OnMinOsTextChanged" />
                        <Button x:Name="MinOsDropdownButton" Content="▾" Width="20" Padding="0"
                                HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                Background="Transparent" BorderThickness="0" FontSize="11"
                                Click="OnMinOsDropdownClick"
                                ToolTip="{x:Static res:Strings.MinOs_DropdownToolTip}" />
                    </Grid>
                </Border>

                <CheckBox x:Name="MergeBundleCheck" Content="{x:Static res:Strings.Toolbar_MergeSameBundle}"
                          Height="24" VerticalContentAlignment="Center" Margin="0,0,10,4"
                          Checked="OnMergeBundleChanged" Unchecked="OnMergeBundleChanged"
                          ToolTip="{x:Static res:Strings.Toolbar_MergeSameBundleToolTip}" />

                <Button x:Name="MultiSelectButton"
                        Content="{x:Static res:Strings.Toolbar_MultiSelect_Off}"
                        Height="24" Padding="8,0" Margin="0,0,6,4"
                        Click="OnToggleMultiSelectClick"
                        ToolTip="{x:Static res:Strings.Toolbar_MultiSelect_ToolTip}" />
                <Button x:Name="DownloadSelectedButton"
                        Height="24" Padding="8,0" Margin="0,0,6,4"
                        IsEnabled="False"
                        Click="OnDownloadSelectedClick"
                        ToolTip="{x:Static res:Strings.Toolbar_DownloadSelectedToolTip}" />
                <Button x:Name="ClearSelectionButton"
                        Content="{x:Static res:Strings.Toolbar_ClearSelection}"
                        Height="24" Padding="8,0" Margin="0,0,10,4"
                        IsEnabled="False"
                        Click="OnClearSelectionClick"
                        ToolTip="{x:Static res:Strings.Toolbar_ClearSelectionToolTip}" />

                <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="0,0,10,4"
                           Foreground="#555" />
            </WrapPanel>
        </Border>

        <Grid x:Name="DownloadDirRow" DockPanel.Dock="Top" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static res:Strings.DownloadDir_Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="DownloadDirCombo" Grid.Column="1" Height="24"
                      VerticalContentAlignment="Center"
                      DisplayMemberPath="DisplayText" SelectedValuePath="FullPath"
                      SelectionChanged="OnDownloadDirSelectionChanged" />
            <StackPanel x:Name="DownloadDirButtonsPanel" Grid.Column="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BrowseDownloadDirButton" Content="{x:Static res:Strings.DownloadDir_Browse}"
                        Height="24" Padding="10,0" Margin="6,0,0,0"
                        Click="OnBrowseDownloadDirClick" />
                <Button x:Name="RightToggleButton"
                        Content="{x:Static res:Strings.Toolbar_HideRight}"
                        Height="24" Padding="8,0" Margin="6,0,0,0"
                        Click="OnToggleRightPaneClick"
                        ToolTip="{x:Static res:Strings.Toolbar_RightToggleToolTip}" />
                <Button x:Name="ImportIndexButton"
                        Content="{x:Static res:Strings.Toolbar_Index}"
                        Height="24" Padding="8,0" Margin="6,0,0,0"
                        Click="OnImportIndexClick"
                        ToolTip="{x:Static res:Strings.Toolbar_ImportIndexToolTip}" />
                <Button x:Name="SettingsButton"
                        Content="{x:Static res:Strings.Toolbar_Settings}"
                        Height="24" Padding="8,0" Margin="6,0,0,0"
                        Click="OnSettingsClick"
                        ToolTip="{x:Static res:Strings.Toolbar_SettingsToolTip}" />
            </StackPanel>
        </Grid>

        <Border x:Name="MissingDbBanner" DockPanel.Dock="Top"
                Visibility="Collapsed"
                Background="#FFEFF6FF" BorderBrush="#FF93C5FD" BorderThickness="1"
                Padding="8,5" Margin="0,0,0,6">
            <DockPanel>
                <Button x:Name="BannerImportButton" DockPanel.Dock="Right"
                        Content="{x:Static res:Strings.Toolbar_ImportIndex}"
                        Padding="10,2" Margin="10,0,0,0"
                        Click="OnImportIndexClick" />
                <TextBlock x:Name="MissingDbBannerText" Foreground="#FF1E3A8A"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="{x:Static res:Strings.Banner_MissingDbText}" />
            </DockPanel>
        </Border>

        <Border x:Name="DownloadDirWarningBanner" DockPanel.Dock="Top"
                Visibility="Collapsed"
                Background="#FFFFF4E5" BorderBrush="#FFE5B870" BorderThickness="1"
                Padding="8,5" Margin="0,0,0,6">
            <TextBlock x:Name="DownloadDirWarningText" Foreground="#FF663C00" TextWrapping="Wrap" />
        </Border>

        <Border x:Name="Aria2NoticeBanner" DockPanel.Dock="Top"
                Visibility="Collapsed"
                Background="#FFFFF4E5" BorderBrush="#FFE5B870" BorderThickness="1"
                Padding="8,5" Margin="0,0,0,6">
            <TextBlock x:Name="Aria2NoticeText" Foreground="#FF663C00" TextWrapping="Wrap" />
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="{x:Static res:Strings.Status_Ready}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="PathText" Foreground="#666" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="MetaText" Foreground="#666" />
            </StatusBarItem>
        </StatusBar>

        <Grid x:Name="MainContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="62*" MinWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightColumn" Width="38*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <local:AlphabetJumpBar x:Name="JumpBar" DockPanel.Dock="Top" Margin="0,0,0,2" />
                <DataGrid x:Name="ResultsGrid"
                          UseLayoutRounding="True" SnapsToDevicePixels="True"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          HeadersVisibility="Column" RowHeight="32"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FFC8C8C8"
                          RowStyle="{StaticResource IndexRowStyle}"
                          CellStyle="{StaticResource IndexCellStyle}"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          LoadingRow="OnLoadingRow"
                          SelectionChanged="OnSelectionChanged"
                          Sorting="OnResultsGridSorting"
                          PreviewMouseLeftButtonDown="OnResultsPreviewMouseLeftButtonDown"
                          PreviewMouseMove="OnResultsPreviewMouseMove"
                          PreviewMouseLeftButtonUp="OnResultsPreviewMouseLeftButtonUp"
                          LostMouseCapture="OnResultsLostMouseCapture"
                          PreviewMouseRightButtonDown="OnResultsPreviewMouseRightButtonDown"
                          PreviewMouseWheel="OnResultsPreviewMouseWheel"
                          ScrollViewer.ScrollChanged="OnResultsScrollChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" />
            </DockPanel>

            <GridSplitter x:Name="MainSplitter" Grid.Column="1" Width="5"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          Background="#FFC8C8C8"
                          MouseDoubleClick="OnMainSplitterDoubleClick" />

            <ContentControl x:Name="RightColumnHost" Grid.Column="2" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid x:Name="RightSectionsGrid">
                    <GroupBox x:Name="DownloadQueuePanel" Header="{x:Static res:Strings.RightSection_Queue}" Padding="4">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                <Button x:Name="QueueSuspendButton"
                                        Content="{x:Static res:Strings.Queue_Suspend}"
                                        Padding="10,2" Margin="0,0,6,2"
                                        Click="OnQueueSuspendClick"
                                        ToolTip="{x:Static res:Strings.Queue_SuspendResumeToolTip}" />
                                <Button x:Name="QueueCancelButton"
                                        Content="{x:Static res:Strings.Queue_Cancel}"
                                        Padding="10,2" Margin="0,0,6,2"
                                        IsEnabled="False"
                                        Click="OnQueueCancelClick"
                                        ToolTip="{x:Static res:Strings.Queue_CancelToolTip}" />
                                <Button x:Name="QueueClearButton"
                                        Content="{x:Static res:Strings.Queue_Clear}"
                                        Padding="10,2" Margin="0,0,8,2"
                                        Click="OnQueueClearClick"
                                        ToolTip="{x:Static res:Strings.Queue_ClearToolTip}" />
                                <TextBlock x:Name="QueueSummaryText"
                                           VerticalAlignment="Center"
                                           FontSize="11" Foreground="#FF666666" Margin="0,0,0,2" />
                            </WrapPanel>
                            <Grid>
                                <ListBox x:Name="QueueList"
                                         DisplayMemberPath="Display"
                                         ItemContainerStyle="{StaticResource QueueItemStyle}"
                                         SelectionChanged="OnQueueSelectionChanged"
                                         PreviewMouseLeftButtonDown="OnQueuePreviewMouseLeftButtonDown" />
                                <TextBlock Text="{x:Static res:Strings.Queue_EmptyHint}"
                                           IsHitTestVisible="False"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="24,12" TextWrapping="Wrap" TextAlignment="Center"
                                           Foreground="#FF888888" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Items.Count, ElementName=QueueList}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </GroupBox>

                    <GroupBox x:Name="DetailsPanel" Header="{x:Static res:Strings.RightSection_Details}" Padding="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="DetailTitle" FontSize="18" FontWeight="Bold"
                                           TextWrapping="Wrap" Margin="0,0,0,4" />
                                <TextBlock x:Name="DetailMeta" Foreground="#555" TextWrapping="Wrap"
                                           Margin="0,0,0,8" />
                                <TextBlock x:Name="DetailCategory" Foreground="#777" TextWrapping="Wrap"
                                           Margin="0,0,0,10" />
                                <TextBlock Text="{x:Static res:Strings.Detail_DescriptionHeader}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock x:Name="DetailDescription" TextWrapping="Wrap"
                                           Foreground="#333" LineHeight="20" Margin="0,0,0,12" />
                                <TextBlock Text="{x:Static res:Strings.Detail_SourcesHeader}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ListBox x:Name="SourcesList" MaxHeight="220"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         PreviewMouseRightButtonDown="OnSourcesPreviewMouseRightButtonDown">
                                    <ListBox.ContextMenu>
                                        <ContextMenu Opened="OnSourcesContextMenuOpened">
                                            <MenuItem x:Name="SourceCopyLinkMenuItem"
                                                      Header="{x:Static res:Strings.Sources_CopyLink}"
                                                      Click="OnSourceCopyMenuClick" />
                                            <MenuItem x:Name="SourceOpenLinkMenuItem"
                                                      Header="{x:Static res:Strings.Sources_OpenLink}"
                                                      Click="OnSourceOpenMenuClick" />
                                            <MenuItem x:Name="SourceOpenWithMenuItem"
                                                      Header="{x:Static res:Strings.Sources_ChooseProgramMenu}"
                                                      Click="OnSourceOpenWithMenuClick" />
                                            <MenuItem x:Name="SourceOpenPageMenuItem"
                                                      Header="{x:Static res:Strings.Sources_OpenPage}"
                                                      Click="OnSourceOpenPageMenuClick" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SourceId}" FontSize="11" Foreground="#777" VerticalAlignment="Center" />
                                                    <Button Content="{x:Static res:Strings.Sources_CopyLink}"
                                                            FontSize="10" Padding="5,1" Margin="8,0,0,0"
                                                            Click="OnSourceCopyClick" />
                                                    <Button Content="{x:Static res:Strings.Sources_OpenLink}"
                                                            FontSize="10" Padding="5,1" Margin="4,0,0,0"
                                                            Click="OnSourceOpenClick" />
                                                    <Button Content="{x:Static res:Strings.Sources_ChooseProgram}"
                                                            FontSize="10" Padding="5,1" Margin="4,0,0,0"
                                                            Click="OnSourceOpenWithClick" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Url}" FontSize="11"
                                                           TextWrapping="Wrap" Foreground="#333" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="DetailHint" Foreground="#999" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </GroupBox>
                </Grid>
            </ContentControl>

            <Border x:Name="RightOverlayBorder" Grid.Column="0" Grid.ColumnSpan="3"
                    Panel.ZIndex="20" HorizontalAlignment="Right"
                    Width="420" Visibility="Collapsed"
                    Background="#FFFFFFFF" BorderBrush="#FFB0B0B0" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Thumb x:Name="RightOverlayResizeThumb" Grid.Column="0"
                           Cursor="SizeWE" Background="#FFC8C8C8"
                           DragDelta="OnOverlayResizeDragDelta" />
                    <ContentControl x:Name="RightOverlayContentHost" Grid.Column="1"
                                    Padding="4,0,0,0"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
